{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/biblia.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4300" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "BibliaTeologica",
    "Audience": "BibliaTeologica",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Identity": {
    "Lockout": { "MaxTentativas": 5, "Minutos": 15 }
  },
  "Email": {
    "Sink": "Dev",
    "Remetente": "nao-responder@biblia-teologica.local",
    "Smtp": { "Host": "", "Port": 587, "User": "", "From": "" }
  },
  "Site": {
    "UrlPublica": ""
  },
  "EnvioEmail": {
    "MaxPorJanela": 3,
    "JanelaMinutos": 15
  },
  "AuthRateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
