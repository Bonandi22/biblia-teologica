# Copiar para .env e preencher. NÃO commitar o .env.
# Chave de assinatura do JWT — gera uma aleatória, ex.: openssl rand -base64 48
BT_JWT_KEY=gera-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# Admin criado no arranque (troca de senha forçada no 1º login)
BT_ADMIN_EMAIL=admin@local
BT_ADMIN_SENHA=Admin!Local1
# E-mail pelo Gmail. Obrigatório em produção; em desenvolvimento o código 2FA vai para o log.
# BT_SMTP_SENHA é uma senha de app do Google, sem espaços, nunca a senha da conta.
BT_SMTP_USER=
BT_SMTP_SENHA=
# Em desenvolvimento, descomente para testar um envio real.
# BT_EMAIL_SINK=Smtp
