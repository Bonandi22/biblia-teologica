      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BibliaTeologica.Application\BibliaTeologica.Application.csproj" />
  </ItemGroup>

</Project>
